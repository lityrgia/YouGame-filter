{
  "manifest_version": 3,
  "name": "YouGame Forum Filter",
  "version": "2.4.0",
  "description": "Скрывает темы из выбранных разделов YouGame.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "host_permissions": ["https://yougame.biz/*", "https://www.yougame.biz/*"],
  "action": {
    "default_title": "Фильтр YouGame",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://yougame.biz/*", "https://www.yougame.biz/*"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://yougame.biz/*", "https://www.yougame.biz/*"],
      "js": ["early-filter.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://yougame.biz/*", "https://www.yougame.biz/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://yougame.biz/*", "https://www.yougame.biz/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
